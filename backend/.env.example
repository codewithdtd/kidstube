# ===================================================================
# KIDSTUBE BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================================
# SAO CHÉP FILE NÀY THÀNH '.env' VÀ ĐIỀN THÔNG TIN THẬT TRÊN MÁY BẠN.
# TUYỆT ĐỐI KHÔNG COMMIT FILE '.env' CHỨA MẬT KHẨU THẬT LÊN GIT!
# ===================================================================

# 1. Cấu hình Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# 2. Cấu hình Neon Cloud PostgreSQL (hoặc Docker Postgres local)
# Ví dụ URL Neon Pooled:
# jdbc:postgresql://ep-xyz-pooler.ap-southeast-1.aws.neon.tech/kidstube?sslmode=require
DATABASE_URL=jdbc:postgresql://<NEON_HOST>/<DB_NAME>?sslmode=require
DATABASE_USERNAME=your_neon_username
DATABASE_PASSWORD=your_neon_password

# 3. Cấu hình HikariCP Connection Pool (Tối ưu cho Serverless Neon)
DB_POOL_MIN_IDLE=2
DB_POOL_MAX_SIZE=10
DB_CONNECTION_TIMEOUT=30000

# 4. Cấu hình Bảo mật JWT (JSON Web Token)
# Secret key tối thiểu 256-bit (32 ký tự ngẫu nhiên hoặc chuỗi Base64)
JWT_SECRET=kidsTubeSecretKeyForJwtSigningMustBeAtLeast256BitsLong2026Secure
# Thời gian hết hạn Access Token (mặc định: 86400000 ms = 24 giờ)
JWT_EXPIRATION_MS=86400000
# Thời gian hết hạn Refresh Token (mặc định: 604800000 ms = 7 ngày)
JWT_REFRESH_EXPIRATION_MS=604800000
